# Required. Generate a unique key; do not commit real credentials.
SR_API_KEYS_JSON=
SR_INITIAL_BALANCES_JSON=
# Required by the SearXNG container. Generate a long random value.
SEARXNG_SECRET=
SR_SEARCH_QPS=100
SR_FETCH_QPS=25
SR_FETCH_DOMAIN_QPS=5
# Provider priority order. Add official providers only after setting their keys.
SR_PROVIDER_PRIORITIES=searxng
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
# Shared rate limiting and billing for multi-replica deployments.
SR_REDIS_URL=redis://redis:6379/0
# Observability.
SR_LOG_JSON=true
SR_LOG_LEVEL=INFO
SR_METRICS_ENABLED=true
SR_TRACING_ENABLED=false
# SR_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
