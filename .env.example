# Required. Generate a unique key; do not commit real credentials.
SF_API_KEYS_JSON=
SF_INITIAL_BALANCES_JSON=
# Required by the SearXNG container. Generate a long random value.
SEARXNG_SECRET=
SF_SEARCH_QPS=100
SF_FETCH_QPS=25
SF_FETCH_DOMAIN_QPS=5
# Provider priority order. Add official providers only after setting their keys.
SF_PROVIDER_PRIORITIES=searxng
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
# Shared rate limiting and billing for multi-replica deployments.
SF_REDIS_URL=redis://redis:6379/0
# Observability.
SF_LOG_JSON=true
SF_LOG_LEVEL=INFO
SF_METRICS_ENABLED=true
SF_TRACING_ENABLED=false
# SF_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
